{
  "name": "personal-finance",
  "version": "0.1.0",
  "private": true,
  "description": "Single-user spending dashboard built on Plaid. Runs on your own Cloudflare account.",
  "scripts": {
    "dev": "node scripts/preflight.mjs && npm run db:migrate:local && next dev -H 127.0.0.1",
    "build": "next build",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "wrangler d1 migrations apply DB --remote && opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "typecheck": "tsc --noEmit",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:import": "node scripts/import-local-db.mjs",
    "db:pull": "node scripts/pull-remote-db.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.16",
    "drizzle-orm": "^0.45.4",
    "jose": "^6.2.15",
    "next": "^16.4.5",
    "plaid": "^50.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-plaid-link": "^5.0.0",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "tailwindcss": "^4.3.4",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "wrangler": "^4.158.0"
  },
  "cloudflare": {
    "bindings": {
      "PLAID_CLIENT_ID": {
        "description": "Your Plaid **Production** client ID, from [dashboard.plaid.com/developers/keys](https://dashboard.plaid.com/developers/keys)."
      },
      "PLAID_SECRET": {
        "description": "Your Plaid **Production** secret, from [dashboard.plaid.com/developers/keys](https://dashboard.plaid.com/developers/keys)."
      },
      "DB": {
        "description": "Stores your accounts and transactions. Cloudflare creates it for you."
      }
    }
  }
}
